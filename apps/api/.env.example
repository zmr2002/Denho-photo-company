OBJECT_STORAGE_SECRET_KEY=replace-with-a-local-secret-key
INQUIRY_NOTIFICATIONS_ENABLED=false
SES_REGION=ap-northeast-1
SES_FROM_ADDRESS=
SES_TO_ADDRESS=
INQUIRY_IP_HASH_KEY=change-this-local-key
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=
ORIGIN_VALIDATION_ENABLED=false
