          "blockType": "heading",
          "heading": "1. 文章标题和摘要的写法",
          "body": null,
          "imagePath": null,
          "imageAlt": null,
          "imageTone": "neutral",
          "caption": null,
          "sortOrder": 2,
          "createdAt": "2026-07-11T01:05:36.803Z",
