SITE_DOMAIN=www.example.com
DATABASE_URL=jdbc:postgresql://database.example.com:5432/tianho?sslmode=require
DATABASE_USERNAME=tianho
DATABASE_PASSWORD=replace-with-database-password
OBJECT_STORAGE_ENDPOINT=https://object-storage.example.com
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=tianho-media
OBJECT_STORAGE_ACCESS_KEY=replace-with-access-key
OBJECT_STORAGE_SECRET_KEY=replace-with-secret-key
INQUIRY_IP_HASH_KEY=replace-with-random-secret
INQUIRY_NOTIFICATIONS_ENABLED=false
SES_REGION=ap-northeast-1
SES_FROM_ADDRESS=website@example.com
SES_TO_ADDRESS=contact@example.com
BACKUP_DB_HOST=database.example.com
BACKUP_DB_PORT=5432
BACKUP_DB_NAME=tianho
BACKUP_DB_SSL_MODE=require
BACKUP_BUCKET=tianho-backups
BACKUP_ENDPOINT=https://backup-storage.example.com
BACKUP_REGION=auto
BACKUP_ACCESS_KEY=replace-with-backup-access-key
BACKUP_SECRET_KEY=replace-with-backup-secret-key
BACKUP_ENCRYPTION_PASSWORD=replace-with-long-random-backup-password
BACKUP_AUTHENTICATION_KEY=replace-with-independent-random-authentication-key
BACKUP_ALERT_WEBHOOK=https://monitoring.example.com/hooks/database-backup
RESTORE_DB_HOST=restore-database.example.com
RESTORE_DB_PORT=5432
RESTORE_DB_ADMIN_USERNAME=restore-check
RESTORE_DB_ADMIN_PASSWORD=replace-with-restore-check-password
RESTORE_DB_SSL_MODE=require
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=replace-with-release-tag
SENTRY_TRACES_SAMPLE_RATE=0.05
