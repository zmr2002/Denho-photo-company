{
  "name": "tianho-photo-company",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @tianho/web",
    "build": "npm run build --workspace @tianho/web",
    "start": "npm run start --workspace @tianho/web",
    "lint": "npm run lint --workspace @tianho/web",
    "test:unit": "npm run test:unit --workspace @tianho/web",
    "services:up": "docker compose -f infra/compose.yml up -d",
    "services:down": "docker compose -f infra/compose.yml down"
  }
}
